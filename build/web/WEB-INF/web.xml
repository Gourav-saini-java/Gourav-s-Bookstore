    </servlet>
    <servlet-mapping>
        <servlet-name>updatelog</servlet-name>
        <url-pattern>/updatelog</url-pattern>
    </servlet-mapping>

    <!-- Update Form Registration -->
    <servlet>
        <servlet-name>updateformreg</servlet-name>
        <jsp-file>/updateformreg.jsp</jsp-file>
    </servlet>
    <servlet-mapping>
        <servlet-name>updateformreg</servlet-name>
        <url-pattern>/updateformreg</url-pattern>
    </servlet-mapping>

    <!-- Update Registration-->
    <servlet>
        <servlet-name>updatereg</servlet-name>
        <jsp-file>/updatereg.jsp</jsp-file>
    </servlet>
    <servlet-mapping>
        <servlet-name>updatereg</servlet-name>
        <url-pattern>/updatereg</url-pattern>
    </servlet-mapping>
    
    <!-- Update Form Order -->
    <servlet>
        <servlet-name>updateformorder</servlet-name>
        <jsp-file>/updateformorder.jsp</jsp-file>
    </servlet>
    <servlet-mapping>
        <servlet-name>updateformorder</servlet-name>
        <url-pattern>/updateformorder</url-pattern>
    </servlet-mapping>

    <!-- Update Order -->
    <servlet>
        <servlet-name>updateorder</servlet-name>
        <jsp-file>/updateorder.jsp</jsp-file>
    </servlet>
    <servlet-mapping>
        <servlet-name>updateorder</servlet-name>
        <url-pattern>/updateorder</url-pattern>
    </servlet-mapping>
    
    <!-- Update Form Order -->
    <servlet>
        <servlet-name>updateformbook</servlet-name>
        <jsp-file>/updateformbook.jsp</jsp-file>
    </servlet>
    <servlet-mapping>
        <servlet-name>updateformbook</servlet-name>
        <url-pattern>/updateformbook</url-pattern>
    </servlet-mapping>

    <!-- Update Order -->
    <servlet>
        <servlet-name>updatebook</servlet-name>
        <jsp-file>/updatebook.jsp</jsp-file>
    </servlet>
    <servlet-mapping>
        <servlet-name>updatebook</servlet-name>
        <url-pattern>/updatebook</url-pattern>
    </servlet-mapping>
    
    <!-- Delete Login -->
    <servlet>
        <servlet-name>deletelog</servlet-name>
        <jsp-file>/deletelog.jsp</jsp-file>
    </servlet>
    <servlet-mapping>
        <servlet-name>deletelog</servlet-name>
