    <!-- All Users -->
    <servlet>
        <servlet-name>allUsers</servlet-name>
        <jsp-file>/allUsers.jsp</jsp-file>
    </servlet>
    <servlet-mapping>
        <servlet-name>allUsers</servlet-name>
        <url-pattern>/allUsers</url-pattern>
    </servlet-mapping>
    
    <!-- Session -->
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

    <!-- Welcome -->
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

</web-app>
